# Groq API key (https://console.groq.com/keys). Server-side only — never prefix with REACT_APP_.
# Local dev: put it in .env.local. Production: Netlify → Site configuration → Environment variables
# (scope it to Functions and mark it as containing secret values).
GROQ_API_KEY=

# Optional: separate secret for signing chat history (any long random string).
CHAT_SIGNING_SECRET=
